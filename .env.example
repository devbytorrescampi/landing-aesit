# Resend — servicio de envío del formulario de contacto (app/actions/contacto.ts)
# Generar la API key en https://resend.com/api-keys luego de verificar el dominio
# de envío en https://resend.com/domains
RESEND_API_KEY=

# Dirección remitente. Debe pertenecer a un dominio verificado en Resend.
CONTACT_FROM_EMAIL="AESIT <contacto@aesit.org.ar>"

# Casilla que recibe las consultas enviadas desde el formulario.
CONTACT_TO_EMAIL=contacto@aesit.org.ar
